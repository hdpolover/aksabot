# ESP-IDF Kconfig overrides for Aksabot firmware
# Applied by pioarduino during CMake configure step.
#
# Problem: MBEDTLS_ERR_SSL_ALLOC_FAILED (-32512) on every WSS connect attempt.
# Root cause: ESP32-S3 internal SRAM is fragmented after 25 modules init.
# Default mbedTLS buffers need ~40KB contiguous DRAM; only ~52KB free (fragmented).
#
# Fix 1 — Reduce SSL buffer sizes (most impactful).
# Default is 16384 each (TLS max record size). WebSocket frames are <1KB;
# 4096 is more than sufficient and cuts the contiguous-heap requirement from ~40KB to ~12KB.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Fix 2 — Route mbedTLS allocations to PSRAM.
# ESP32-S3 has 8MB PSRAM free; SSL context (~4-8KB) fits there with no fragmentation risk.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Fix 3 — Allow large heap allocations to spill into PSRAM automatically.
# Allocations ≤4KB stay in internal SRAM (FreeRTOS internals, small structs, ISR data).
# Anything larger (SSL contexts, HTTP buffers, etc.) can fall back to PSRAM
# when internal SRAM is under pressure.
# NOTE: This only affects malloc()/calloc() — FreeRTOS xTaskCreate() uses its own
# allocator that always targets internal DRAM. For PSRAM task stacks, use
# xTaskCreatePinnedToCoreWithCaps(..., MALLOC_CAP_SPIRAM) instead.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Fix 4 — Allow WiFi stack and LwIP to use PSRAM, freeing ~30KB of internal heap.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Fix 5 — Disable hardware AES accelerator so AES uses software implementation.
# Hardware AES (default) calls heap_caps_malloc(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL)
# for each TLS record — bypassing the mbedTLS PSRAM allocator entirely.
# During active TTS streaming, these DMA allocations (up to 16KB per record)
# exhaust internal SRAM and cause MBEDTLS_ERR_SSL_INTERNAL_ERROR → WS disconnect.
# Software AES routes through mbedTLS allocator (our PSRAM hook) instead.
# Throughput cost is negligible for <1KB WebSocket frames.
CONFIG_MBEDTLS_HARDWARE_AES=n
